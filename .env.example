# Application Settings
APP_NAME=AgriLink
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# LLM Providers
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4-turbo-preview
FALLBACK_MODEL=claude-3-sonnet-20240229

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Vector Database
VECTOR_DB_TYPE=chroma  # Options: chroma, pinecone, faiss
CHROMA_PERSIST_DIR=./data/chroma
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=agrilink

# Redis (Event Bus & Short-term Memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (Long-term Memory)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrilink
POSTGRES_USER=agrilink
POSTGRES_PASSWORD=agrilink_password
DATABASE_URL=postgresql+asyncpg://agrilink:agrilink_password@localhost:5432/agrilink

# External APIs
WEATHER_API_PROVIDER=openweathermap  # Options: openweathermap, weatherapi
OPENWEATHER_API_KEY=your-openweather-api-key-here
WEATHERAPI_KEY=your-weatherapi-key-here

# Market Data APIs (to be configured based on region)
MARKET_API_ENABLED=false
MARKET_API_URL=
MARKET_API_KEY=

# Real-time Delivery
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10

# Notifications
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false

# SMS Provider (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Provider (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_ENABLE_RERANKING=true
RAG_ENABLE_HYBRID_SEARCH=true

# Agent Configuration
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_ITERATIONS=5
ORCHESTRATOR_CONFIDENCE_THRESHOLD=0.8

# Safety & Guardrails
ENABLE_RAG_VALIDATION=true
ENABLE_CONFIDENCE_SCORING=true
ENABLE_AUDIT_LOGGING=true
MINIMUM_CONFIDENCE_FOR_ACTION=0.7

# Performance
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_AGENTS=10
